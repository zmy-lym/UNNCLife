# Redirect npm's cache into the project so npm never needs to write
# to the home directory (~/.npm), which is blocked on this machine.
# node_modules is already ignored by git, so this cache stays invisible to git too.
cache=node_modules/.npm-cache

# Use the npmmirror registry (Alibaba's mirror of registry.npmjs.org) because
# direct access to the official registry is extremely slow on this network.
# Delete the line below to switch back to the official registry.
registry=https://registry.npmmirror.com/
